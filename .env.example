# Railway backend variables. Copy the host/database/user/password from Neon.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://your-neon-pooler-host/neondb?sslmode=require
DATABASE_USERNAME=your-neon-role
DATABASE_PASSWORD=your-neon-password
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=0

# Vercel reaches Railway through a same-origin server-side proxy.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Optional integrations
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder
RAZORPAY_MONTHLY_PLAN_ID=plan_placeholder
RAZORPAY_YEARLY_PLAN_ID=plan_placeholder
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=mock
MAIL_PASSWORD=mock
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
