# Backend variables. DATABASE_URL accepts the pooled connection string copied directly from Neon.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=postgresql://your-neon-role:your-neon-password@your-neon-pooler-host/neondb?sslmode=require
# Optional when the credentials are already embedded in DATABASE_URL:
# DATABASE_USERNAME=your-neon-role
# DATABASE_PASSWORD=your-neon-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=0
JPA_DDL_AUTO=validate

# Vercel reaches Railway through a same-origin server-side proxy.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Optional integrations
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder
RAZORPAY_MONTHLY_PLAN_ID=plan_placeholder
RAZORPAY_YEARLY_PLAN_ID=plan_placeholder
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=mock
MAIL_PASSWORD=mock
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@your-domain.com

# Neon Object Storage (copy values produced by `neon config init` to the backend host)
STORAGE_ENABLED=false
STORAGE_BUCKET=uploads
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=https://replace-me
AWS_REGION=aws-ap-southeast-1

# Base64-encoded 32-byte key used to encrypt WhatsApp access tokens at rest.
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
